 "html": "{% set member = doc %}\r\n<!DOCTYPE html>\r\n<html>\r\n<head>\r\n    <style>\r\n        body { font-family: Arial, sans-serif; }\r\n        h2 { margin-bottom: 0; }\r\n        .member-info, .fine-table, .books-table { width: 100%; border-collapse: collapse; margin-top: 20px; }\r\n        .member-info td { padding: 5px 10px; }\r\n        .fine-table th, .fine-table td, .books-table th, .books-table td { border: 1px solid #ccc; padding: 8px; text-align: left; }\r\n        .fine-table th, .books-table th { background-color: #f2f2f2; }\r\n        .section-title { margin-top: 30px; font-weight: bold; }\r\n    </style>\r\n</head>\r\n<body>\r\n    <h2>Library Member</h2>\r\n    <small>{{ member.name }}</small>\r\n\r\n    <table class=\"member-info\">\r\n        <tr>\r\n            <td><strong>Name:</strong> {{ member.name1 }}</td>\r\n            <td><strong>Membership Start Date:</strong> {{ member.membership_start_date }}</td>\r\n        </tr>\r\n        <tr>\r\n            <td><strong>Email:</strong> {{ member.email }}</td>\r\n            <td><strong>Membership End Date:</strong> {{ member.membership_end_date }}</td>\r\n        </tr>\r\n        <tr>\r\n            <td><strong>Mobile No:</strong> {{ member.mobile_no }}</td>\r\n            <td></td>\r\n        </tr>\r\n    </table>\r\n\r\n    <div class=\"section-title\">Fines</div>\r\n    <table class=\"fine-table\">\r\n        <tr>\r\n            <th>Sr</th>\r\n            <th>Fine Date</th>\r\n            <th>Amount</th>\r\n            <th>Reason</th>\r\n        </tr>\r\n        {% for fine in member.fine_details %}\r\n        <tr>\r\n            <td>{{ loop.index }}</td>\r\n            <td>{{ fine.fine_date }}</td>\r\n            <td>\u20b9 {{ fine.amount }}</td>\r\n            <td>{{ fine.reason }}</td>\r\n        </tr>\r\n        {% endfor %}\r\n    </table>\r\n\r\n    <div class=\"section-title\">Issued Books</div>\r\n    <table class=\"books-table\">\r\n        <tr>\r\n            <th>Sr</th>\r\n            <th>Book Name</th>\r\n            <th>From Date</th>\r\n            <th>To Date</th>\r\n            <th>Return Date</th>\r\n            <th>Status</th>\r\n        </tr>\r\n        {% for book in member.book_details %}\r\n        <tr>\r\n            <td>{{ loop.index }}</td>\r\n            <td>{{ book.book_name }}</td>\r\n            <td>{{ book.from_date }}</td>\r\n            <td>{{ book.to_date }}</td>\r\n            <td>{{ book.return_date or '' }}</td>\r\n            <td>{{ book.status }}</td>\r\n        </tr>\r\n        {% endfor %}\r\n    </table>\r\n</body>\r\n</html>\r\n",
